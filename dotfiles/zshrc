# Homebrew
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export EDITOR=vim
export PATH="$HOME/bin:$HOME/go/bin:$PATH"

# mise
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# direnv
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# prompt (git branch/status, current directory = worktree name); config: ~/.config/starship.toml
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

autoload -U compinit && compinit

# History
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY HIST_FCNTL_LOCK
unsetopt APPEND_HISTORY EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_FIND_NO_DUPS HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS

# NEVER `brew cu` / `--greedy` / `mise bootstrap --upgrade`, and never run `mise bootstrap packages upgrade` without
# explicit package names: reinstalling microsoft-office from its .pkg wipes Outlook accounts and signatures.
# Office updates come from Microsoft AutoUpdate only.
# Casks that brew owns are upgraded by `brew upgrade` (self-updating ones are skipped: no --greedy); casks that mise
# installed are upgraded by `mise bootstrap packages upgrade`, passed an explicit list WITHOUT any microsoft-* cask.
update() {
  (unset HOMEBREW_UPGRADE_GREEDY HOMEBREW_UPGRADE_GREEDY_CASKS; brew update && brew upgrade && brew cleanup) || return
  local -a pkgs
  pkgs=(${(f)"$(grep -o '"brew-cask:[^"]*"' ~/.dotfiles/mise.toml | tr -d '"' | grep -v 'brew-cask:microsoft-')"})
  # Refuse to run with an empty list: mise would then upgrade EVERY package, including Office.
  (( $#pkgs )) || { echo "update: no casks found in ~/.dotfiles/mise.toml; not upgrading casks" >&2; return 1; }
  mise bootstrap packages upgrade --yes $pkgs && mise upgrade
}
