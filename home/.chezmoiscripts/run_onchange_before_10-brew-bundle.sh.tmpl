#!/bin/bash
# Brewfile hash (reruns when it changes): {{ joinPath .chezmoi.sourceDir ".." "Brewfile" | include | sha256sum }}
# NEVER add --cleanup / --zap / upgrade here (see docs/MIGRATION.md, Outlook).
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"
brewfile="{{ .chezmoi.sourceDir }}/../Brewfile"

# A failing cask must not abort the whole chezmoi apply.
if ! brew bundle install --no-upgrade --file="$brewfile"; then
  echo "brew bundle had failures; rerun: brew bundle install --no-upgrade --file='$brewfile'" >&2
fi
exit 0
