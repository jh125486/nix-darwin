#!/bin/bash
# Brewfile hash (reruns when it changes): {{ joinPath .chezmoi.sourceDir ".." "Brewfile" | include | sha256sum }}
# NEVER add --cleanup / --zap / upgrade here (see docs/MIGRATION.md, Outlook).
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"
brew bundle install --no-upgrade --file="{{ .chezmoi.sourceDir }}/../Brewfile"
